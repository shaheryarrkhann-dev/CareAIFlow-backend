# CareAIFlow API — example env (copy to .env). Stripe TEST for local; live = swap keys/prices.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/postgres

FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- Stripe (TEST now; LIVE later = sk_live_ / pk_live_ + live price IDs + live webhook secret) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_...
STRIPE_PRICE_PROFESSIONAL_ANNUAL=price_...
STRIPE_PRICE_MULTI_HOME_MONTHLY=price_...
STRIPE_PRICE_MULTI_HOME_ANNUAL=price_...
STRIPE_PRICE_EXTRA_FACILITY_MONTHLY=price_...
STRIPE_PRICE_EXTRA_FACILITY_ANNUAL=price_...

# --- Onboarding launch knobs (no code change to flip) ---
SELF_SERVE_CHECKOUT_ENABLED=true
TRIAL_DAYS=0
RESIDENT_CAPACITY_PER_FACILITY=6
ONBOARDING_PAUSE_REMINDER_DAYS=3
ONBOARDING_PAUSE_REMINDER_CRON=true

# Landing lead form notify (defaults to alirazaarif95@gmail.com if unset)
LEAD_NOTIFY_EMAIL=alirazaarif95@gmail.com

# Email (SendGrid / SMTP / test)
EMAIL_FROM_NAME=CareAIFlow
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
