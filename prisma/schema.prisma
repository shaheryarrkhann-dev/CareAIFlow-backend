// Resident document folder system
model ResidentFolder {
  id           String           @id @default(uuid())
  residentId   String
  resident     Resident         @relation(fields: [residentId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       ResidentFolder?  @relation("ResidentFolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     ResidentFolder[] @relation("ResidentFolderHierarchy")
  name         String
  allowedRoles Json? // ["ADMIN", "STAFF"] or null = visible to all roles
  size         FolderSize       @default(MEDIUM)
  color        String? // e.g. hex #rrggbb or preset name for easier identification
  passwordHash String? // bcrypt hash; never returned in API
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  documents ResidentDocument[]

  @@index([residentId])
  @@index([parentId])
  @@map("resident_folders")
}

enum ResidentDocumentCategory {
  LEGAL
  MEDICAL
  EXTERNAL_REPORT
  OTHER
}

model ResidentDocument {
  id         String                    @id @default(uuid())
  residentId String
  resident   Resident                  @relation(fields: [residentId], references: [id], onDelete: Cascade)
  folderId   String?
  folder     ResidentFolder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  category   ResidentDocumentCategory?
  tags       String[]                  @default([])
  isPinned   Boolean                   @default(false)
  fileName   String
  s3Key      String
  s3Url      String
  fileSize   Int?
  mimeType       String?
  expirationDate DateTime? @map("expiration_date") @db.Date
  uploadedBy     String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([residentId])
  @@index([folderId])
  @@index([category])
  @@index([isPinned])
  @@index([expirationDate])
  @@map("resident_documents")
}

// Note Versions - Immutable edit history for notes (full snapshots)
model NoteVersion {
  id           String   @id @default(uuid())
  noteId       String
  note         Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  version      Int // Version number (0 = creation, 1, 2, 3... = edits)
  residentId   String // Full note snapshot: Resident.id (UUID)
  residentName String? // Full note snapshot: resident name
  staffId      String? // Full note snapshot: staff who created this version (null if user deleted)
  staff        User?    @relation("NoteVersionStaff", fields: [staffId], references: [id], onDelete: SetNull)
  tenantId     String // Full note snapshot: tenant ID
  type         NoteType // Full note snapshot: note type
  description  String   @db.Text // Full note snapshot: description at this version
  createdBy    String? // User who created this version (null if user deleted)
  creator      User?    @relation("NoteVersionCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) // When this version was created

  @@unique([noteId, version]) // Ensure one version per number per note
  @@index([noteId])
  @@index([noteId, version])
  @@index([createdBy])
  @@index([createdAt])
  @@map("note_versions")
}

// Billing Tiers - Care level pricing tiers
model BillingTier {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String // e.g., "Tier 1", "Basic ADL Support"
  description String? // Notes about tier care level
  monthlyRate Decimal  @db.Decimal(10, 2) // Monthly cost
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  residentBillings ResidentBilling[]
  invoices         Invoice[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("billing_tiers")
}

// Resident Billing Mapping - Links residents to billing tiers
model ResidentBilling {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  residentId    String // Resident.id (UUID)
  residentName  String? // Cached resident name for display
  billingTierId String
  billingTier   BillingTier @relation(fields: [billingTierId], references: [id], onDelete: Restrict)
  startDate     DateTime // When billing tier assignment started
  endDate       DateTime? // Optional: when billing tier assignment ended
  isActive      Boolean     @default(true) // Current active tier
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  createdBy     String? // User ID who assigned tier

  invoices Invoice[]

  @@unique([tenantId, residentId, isActive]) // Only one active tier per resident
  @@index([tenantId])
  @@index([residentId])
  @@index([billingTierId])
  @@index([tenantId, residentId])
  @@index([isActive])
  @@map("resident_billing")
}

// Invoices - Monthly billing invoices
model Invoice {
  id                String           @id @default(uuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceNumber     String           @unique // Auto-generated: INV-2025-01-{sequence}
  residentId        String // Resident.id (UUID)
  residentName      String? // Cached resident name
  residentBillingId String? // Reference to resident billing record
  residentBilling   ResidentBilling? @relation(fields: [residentBillingId], references: [id], onDelete: SetNull)
  billingTierId     String
  billingTier       BillingTier      @relation(fields: [billingTierId], references: [id], onDelete: Restrict)
  amount            Decimal          @db.Decimal(10, 2) // Based on tier monthly rate
  month             DateTime // Billing period (first day of month)
  status            InvoiceStatus    @default(Pending)
  dueDate           DateTime? // Optional: calculated based on month
  generatedBy       String? // "System" or user ID
  paidAt            DateTime? // When marked as paid
  paidBy            String? // User ID who marked as paid
  notes             String? // Additional notes
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([tenantId, residentId, month]) // One invoice per resident per month
  @@index([tenantId])
  @@index([residentId])
  @@index([billingTierId])
  @@index([status])
  @@index([month])
  @@index([tenantId, month])
  @@index([tenantId, status])
  @@map("invoices")
}

// Enum for invoice status
enum InvoiceStatus {
  Pending
  Paid
  Overdue
}

// ============================================
// Healthcare Claims Billing Models
// ============================================

// Billing status for claims billing records (system-only; not exported to Excel)
enum ClaimsBillingStatus {
  PENDING // Unpaid
  PAID // Fully paid
  PARTIAL // Partially paid
  OVERDUE // Past due, unpaid
}

// Claims Billing Record - Main billing record table for healthcare claims
model ClaimsBillingRecord {
  id             String   @id @default(uuid())
  tenantId       String
  residentId     String // Resident.id (UUID)
  billingMonth   DateTime // First day of billing month
  rowIndex       Int // Excel row index (1-based, excluding header)
  excelSheetName String // Resident sheet name

  // Billing status (system-only; not in Excel export)
  billingStatus ClaimsBillingStatus @default(PENDING)
  paidAmount    Decimal?            @db.Decimal(10, 2)
  paidAt        DateTime?

  // Provider Fields
  providerName            String?
  providerId              String?
  tinSsnEin               String?
  billingProviderNpi      String?
  billingProviderTaxonomy String?
  billingProviderStreet   String?
  billingProviderCity     String?
  billingProviderState    String?
  billingProviderZip      String?

  // Service Fields
  tierId            String? // Reference to ClaimsBillingTier
  tierUnitCost      Decimal? @db.Decimal(10, 2)
  serviceCode       String?
  modifier1         String?
  modifier2         String?
  units             Int?
  claimBilledAmount Decimal? @db.Decimal(10, 2)

  // Client Fields
  clientAddress   String?
  clientCity      String?
  clientState     String?
  clientZip       String?
  placeOfService  String?
  clientId        String?
  clientLastName  String?
  clientFirstName String?
  clientGender    String?
  clientDob       DateTime?
  diagnosisCode   String?

  // Service Dates
  serviceFromDate DateTime?
  serviceToDate   DateTime?

  // MCO Fields (empty by default)
  originalClaimId String?
  frequencyCode   String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tier   ClaimsBillingTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)

  @@unique([tenantId, residentId, billingMonth])
  @@index([tenantId])
  @@index([residentId])
  @@index([billingMonth])
  @@index([tenantId, residentId])
  @@index([tierId])
  @@index([billingStatus])
  @@map("claims_billing_records")
}

// Claims Billing Tier - Tier configuration for healthcare claims billing
model ClaimsBillingTier {
  id          String   @id @default(uuid())
  tenantId    String
  tierNumber  Int // 1-6 (same for Regular and ILOS)
  isILOS      Boolean  @default(false) // Distinguishes Regular vs ILOS tiers
  name        String // "Tier 1" or "ILOS T1"
  unitCost    Decimal  @db.Decimal(10, 2) // Daily rate
  modifier1   String? // Regular: "-", "TF", "HE", "TG", "HK", "HI" | ILOS T1: "SE" | ILOS T2-6: same as Regular
  modifier2   String? // Regular: (Blank) | ILOS T1: (Blank) | ILOS T2-6: "SE"
  serviceCode String   @default("S5126")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  records   ClaimsBillingRecord[]
  residents Resident[] // Residents with this as default tier

  @@unique([tenantId, tierNumber, isILOS]) // Allow both Regular and ILOS for same tier number
  @@index([tenantId])
  @@index([tenantId, isILOS])
  @@index([tenantId, isActive])
  @@map("claims_billing_tiers")
}

// Claims Provider Settings - Provider information per tenant
model ClaimsProviderSettings {
  id                      String   @id @default(uuid())
  tenantId                String   @unique
  providerName            String
  providerId              String?
  tinSsnEin               String
  billingProviderNpi      String
  billingProviderTaxonomy String
  billingProviderStreet   String
  billingProviderCity     String
  billingProviderState    String
  billingProviderZip      String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("claims_provider_settings")
}

// ============================================
// Role & Permission Engine
// ============================================

model Permission {
  id        String   @id @default(uuid())
  module    String // e.g. RESIDENTS, EMAR, BILLING, ADMINISTRATION
  action    String // e.g. view, create, update, delete, export
  name      String? // Human-readable label
  createdAt DateTime @default(now())

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@index([module])
  @@map("permissions")
}

model CustomRole {
  id               String   @id @default(uuid())
  tenantId         String? // Null for system templates (global)
  tenant           Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  description      String?  @db.Text
  isSystemTemplate Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  rolePermissions     RolePermission[]
  userRoleAssignments UserRoleAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([isSystemTemplate])
  @@map("roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String
  role       CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenantId   String // Denormalized for quick filtering
  isPrimary  Boolean    @default(false)
  assignedAt DateTime   @default(now())
  assignedBy String? // User ID who assigned

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([tenantId])
  @@map("user_role_assignments")
}

// Audit Log - Immutable audit trail for all system actions
model AuditLog {
  id           String      @id @default(uuid())
  userId       String? // Null for unauthenticated actions
  userName     String? // Name of user performing action
  userEmail    String? // Email of user performing action
  userRole     String? // Role of user performing action
  tenantId     String? // Null for system-wide actions
  action       AuditAction // Type of action performed
  resource     String // Resource affected (e.g., "user", "tenant", "form")
  resourceId   String? // ID of the affected resource
  description  String? // Human-readable log message
  method       String? // HTTP method (GET, POST, PUT, DELETE)
  endpoint     String? // API endpoint called
  statusCode   Int? // HTTP status code
  ipAddress    String? // IP address of the requester
  /// Human-readable location from IP_GEOLOCATION_KEY (ipgeolocation.io), e.g. "City, State, Country"
  ipGeoSummary String?     @map("ip_geo_summary") @db.VarChar(512)
  userAgent    String? // User agent string
  requestData  Json? // Sanitized request payload (sensitive data removed)
  responseData Json? // Sanitized response data (for important actions)
  errorMessage String? // Error message if action failed
  duration     Int? // Request duration in milliseconds
  metadata     Json? // Additional metadata
  createdAt    DateTime    @default(now())

  @@index([userId])
  @@index([userEmail])
  @@index([tenantId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ============================================
// eMAR (Electronic Medication Administration Record) Models
// ============================================

// Medication - Master medication list per resident
model Medication {
  id         String @id @default(uuid())
  residentId String // Resident.id (UUID)
  tenantId   String
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Medication Details
  name        String // Medication name (e.g., "Metformin")
  dosage      String // Dosage (e.g., "500mg")
  route       MedicationRoute // Oral, IM, Topical, Eye, Ear
  frequency   String // Frequency description (e.g., "Twice daily", "8AM, 12PM, 4PM, 8PM")
  timesPerDay Int? // Number of times per day (for scheduling)
  timeSlots   Json? // Array of time slots ["08:00", "12:00", "16:00", "20:00"]

  // Dates & Status
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean   @default(true)
  isPrn     Boolean   @default(false) // PRN (as needed) medication

  // Special Requirements
  requiresVitals Boolean @default(false) // Must record vitals before dose
  vitalsType     String? // "Temperature", "BloodPressure", "Pulse", "All"

  // Prescriber & Pharmacy
  prescriberName  String?
  prescriberPhone String?
  pharmacyName    String?
  pharmacyPhone   String?

  // Instructions & Attachments
  specialInstructions String? @db.Text
  prescriptionPdfUrl  String? // S3 URL for prescription PDF
  prescriptionS3Key   String? // S3 key for prescription PDF

  // Metadata
  createdBy String? // User ID who added medication
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  // Relations
  schedules     MedicationSchedule[]
  marRecords    MarRecord[]
  prnRecords    PrnRecord[]
  prescriptions MedicationPrescription[]

  @@index([residentId])
  @@index([tenantId])
  @@index([tenantId, residentId])
  @@index([tenantId, residentId, isActive])
  @@index([isActive])
  @@map("medications")
}

enum MedicationRoute {
  Oral
  IM // Intramuscular
  IV // Intravenous
  Topical
  Eye
  Ear
  Sublingual
  Nasal
  Other
}

// MedicationSchedule - Auto-generated scheduled doses
model MedicationSchedule {
  id           String     @id @default(uuid())
  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  residentId   String
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Schedule Details
  scheduledDate DateTime // Date for this dose
  scheduledTime DateTime // Full datetime for scheduled dose
  timeSlot      String // Time slot label (e.g., "8AM", "12PM")

  // Status
  status        ScheduleStatus @default(Pending)
  isMissed      Boolean        @default(false)
  isLate        Boolean        @default(false)
  lateThreshold Int? // Minutes after scheduled time to mark as late (default: 120)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  marRecord MarRecord? @relation("ScheduleMarRecord") // Link to actual administration record

  @@unique([medicationId, scheduledTime]) // One schedule per medication per time
  @@index([residentId])
  @@index([tenantId])
  @@index([tenantId, residentId])
  @@index([scheduledDate])
  @@index([scheduledTime])
  @@index([status])
  @@index([tenantId, scheduledDate])
  @@map("medication_schedules")
}

enum ScheduleStatus {
  Pending // Not yet due
  Given // Administered
  Missed // Missed dose
  Late // Given late
  Skipped // Intentionally skipped
  Hold // On hold
}

// MarRecord - Individual dose administration record
model MarRecord {
  id           String              @id @default(uuid())
  medicationId String
  medication   Medication          @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  scheduleId   String?             @unique // Link to scheduled dose (if scheduled) - one-to-one
  schedule     MedicationSchedule? @relation("ScheduleMarRecord", fields: [scheduleId], references: [id], onDelete: SetNull)
  residentId   String
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Administration Details
  administeredAt DateTime // When medication was given
  scheduledTime  DateTime // Original scheduled time
  status         MarStatus // Given, Missed, Late

  // Caregiver Information
  caregiverId       String? // User ID who administered (null if user deleted)
  caregiver         User?   @relation("MarRecordCaregiver", fields: [caregiverId], references: [id], onDelete: SetNull)
  caregiverName     String? // Cached caregiver name
  caregiverInitials String? // Caregiver initials for MAR grid
  signature         String? // Digital signature (base64 or S3 URL)
  signatureType     String? // "drawing", "typed", "stored"

  // Notes & Observations
  notes            String? @db.Text
  residentResponse String? @db.Text // How resident responded

  // Status Reason Fields
  notGivenReason String? @db.Text // Reason when status is NotGiven (e.g., "out of stock", "held due to vitals")
  refusedReason  String? @db.Text // Reason when status is Refused (e.g., "refused by resident")

  // Vitals (if required)
  vitalsId String?    @unique // Link to vitals record (one-to-one)
  vitals   VitalSign? @relation("MarRecordVitals", fields: [vitalsId], references: [id], onDelete: SetNull)

  // Edit Lock (24-hour rule)
  isLocked Boolean   @default(false)
  lockedAt DateTime? // When record was locked (24 hours after administeredAt)
  canEdit  Boolean   @default(true) // Admin override flag

  // Metadata
  createdBy String // User ID who created record
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime? // Last edit time
  editedBy  String? // Last editor user ID

  @@index([residentId])
  @@index([tenantId])
  @@index([medicationId])
  @@index([caregiverId])
  @@index([administeredAt])
  @@index([tenantId, residentId])
  @@index([tenantId, residentId, administeredAt])
  @@index([scheduleId])
  @@map("mar_records")
}

enum MarStatus {
  Given
  NotGiven
  Refused
  Missed // Legacy - will be mapped to NotGiven
  Late // Legacy - will be mapped to Given
  Skipped // Legacy - will be mapped to NotGiven
  Hold // Legacy - will be mapped to NotGiven
}

// PrnRecord - PRN (as needed) medication log
model PrnRecord {
  id           String     @id @default(uuid())
  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  residentId   String
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // PRN Workflow
  whyGiven          String   @db.Text // Why the PRN was given (reason for administration)
  symptomsNoted     String?  @db.Text // Symptoms noted at time of administration
  symptom           String   @db.Text // Legacy field - kept for backward compatibility (maps to whyGiven)
  givenAt           DateTime // When medication was given
  caregiverId       String? // User ID who gave medication (null if user deleted)
  caregiver         User?    @relation("PrnRecordCaregiver", fields: [caregiverId], references: [id], onDelete: SetNull)
  caregiverName     String?
  caregiverInitials String?
  signature         String? // Digital signature

  // Follow-up (required after 30-60 min)
  response            String?   @db.Text // Resident response/outcome (effectiveness follow-up)
  effectiveness       String?   @db.Text // Effectiveness of medication (alternative to response, more structured)
  responseRecordedAt  DateTime? // When response was recorded
  physicianNotified   Boolean   @default(false)
  physicianNotifiedAt DateTime?
  physicianNotes      String?   @db.Text

  // Vitals (if applicable)
  vitalsId String?    @unique // Link to vitals record (one-to-one)
  vitals   VitalSign? @relation("PrnRecordVitals", fields: [vitalsId], references: [id], onDelete: SetNull)

  // Notes
  notes String? @db.Text

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  behavioralLogs BehavioralLog[] @relation("BehavioralLogPrnRecord") // Behavioral logs that reference this PRN record

  @@index([residentId])
  @@index([tenantId])
  @@index([medicationId])
  @@index([caregiverId])
  @@index([givenAt])
  @@index([tenantId, residentId])
  @@index([tenantId, residentId, givenAt])
  @@map("prn_records")
}

// VitalSign - Vitals tracking (linked to medications/records)
model VitalSign {
  id         String @id @default(uuid())
  residentId String
  tenantId   String
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Vital Signs
  bloodPressureSystolic  Int? // Systolic BP
  bloodPressureDiastolic Int? // Diastolic BP
  pulse                  Int? // Pulse rate
  temperature            Decimal? @db.Decimal(4, 1) // Temperature (Fahrenheit)
  temperatureUnit        String?  @default("F") // "F" or "C"
  oxygenSaturation       Int? // O2 Sat (%)
  weight                 Decimal? @db.Decimal(5, 2) // Weight (lbs)
  weightUnit             String?  @default("lbs")

  // Context
  recordedAt     DateTime // When vitals were taken
  recordedBy     String? // User ID who recorded (null if user deleted)
  recorder       User?    @relation("VitalSignRecorder", fields: [recordedBy], references: [id], onDelete: SetNull)
  recordedByName String?

  // Links
  medicationId String? // If linked to specific medication (reference only, not a relation)

  // Notes
  notes String? @db.Text

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations (back-references from MarRecord and PrnRecord)
  marRecord MarRecord? @relation("MarRecordVitals")
  prnRecord PrnRecord? @relation("PrnRecordVitals")

  @@index([residentId])
  @@index([tenantId])
  @@index([recordedAt])
  @@index([tenantId, residentId])
  @@index([tenantId, residentId, recordedAt])
  @@index([medicationId])
  @@map("vital_signs")
}

// MedicationPrescription - Prescription PDF attachments
model MedicationPrescription {
  id           String     @id @default(uuid())
  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // File Information
  fileName String
  s3Key    String // S3 storage key
  s3Url    String // S3 URL
  fileSize Int? // File size in bytes
  mimeType String? // MIME type (e.g., "application/pdf")

  // Metadata
  uploadedBy String? // User ID who uploaded
  uploadedAt DateTime @default(now())

  @@index([medicationId])
  @@index([tenantId])
  @@map("medication_prescriptions")
}

// ============================================
// CBHS Behavioral Tracking Models
// ============================================

// Enum for behavior types
enum BehaviorType {
  Aggression
  SelfHarm
  Withdrawal
  NonCompliance
  MoodChanges
  Anxiety
  Agitation
  VerbalAbuse
  PhysicalAbuse
  PropertyDamage
  Wandering
  InappropriateBehavior
  Other
}

// Enum for severity levels
enum SeverityLevel {
  Low
  Moderate
  High
}

// Enum for intervention types (stored as array in BehavioralLog)
enum InterventionType {
  Redirect
  Counseling
  PrnMedication
  TimeOut
  DeEscalation
  EnvironmentalModification
  StaffSupport
  FamilyNotification
  PhysicianNotification
  EmergencyResponse
  Other
}

// BehavioralLog - Daily behavioral incident entries
model BehavioralLog {
  id           String  @id @default(uuid())
  residentId   String // Resident.id (UUID)
  residentName String? // Cached resident name for display
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Behavioral Details
  dateTime            DateTime // Date and time of behavior
  duration            String? // Duration of service (e.g., "12 hours", "2 hours 30 minutes")
  behaviorType        BehaviorType? // Type of behavior (optional)
  observedBehaviors   Json? // Array of behavior names (string[]) - NEW: Multiple behaviors
  severity            SeverityLevel // Severity level
  trigger             String?       @db.Text // Trigger/context (free text)
  staffNotes          String?       @db.Text // Staff observations and notes
  residentExplanation String?       @map("resident_explanation") @db.Text // Resident's explanation of the behavior
  outcome             String?       @db.Text // Outcome of the intervention
  interventions       Json // Array of InterventionType values applied (required)
  interventionDetails String?       @db.Text // Additional details about interventions
  selectedTier        String? // Selected tier (e.g., "Tier 1 (.5-2)", "Tier 2 (2.1-6)", etc.)
  services            Json? // Array of services for batch records (only populated for batch submissions)

  // Staff Information
  staffId   String? // User ID who logged the behavior (null if user deleted)
  staff     User?   @relation("BehavioralLogStaff", fields: [staffId], references: [id], onDelete: SetNull)
  staffName String? // Cached staff name

  // Link to PRN medication (if PRN med was given)
  prnRecordId String? // Optional link to PRN record if medication was administered
  prnRecord   PrnRecord? @relation("BehavioralLogPrnRecord", fields: [prnRecordId], references: [id], onDelete: SetNull)

  // Edit Restrictions (similar to MAR records)
  isLocked Boolean   @default(false)
  lockedAt DateTime? // When record was locked (24 hours after dateTime)
  canEdit  Boolean   @default(true) // Admin override flag

  // Soft Delete
  deletedAt DateTime? // Soft delete timestamp

  // Metadata
  createdBy String // User ID who created record
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime? // Last edit time
  editedBy  String? // Last editor user ID

  @@index([residentId])
  @@index([tenantId])
  @@index([staffId])
  @@index([dateTime])
  @@index([behaviorType])
  @@index([severity])
  @@index([tenantId, residentId])
  @@index([tenantId, residentId, dateTime])
  @@index([tenantId, dateTime])
  @@index([deletedAt])
  @@map("behavioral_logs")
}

// AFH / DSHS-aligned incident reports (resident welfare)
model IncidentReport {
  id                    String            @id @default(uuid())
  tenantId              String
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  residentId            String
  residentName          String?
  occurredAt            DateTime
  incidentType          String
  incidentTypeOtherText String?
  status                String            @default("Open")
  severity              IncidentSeverity?
  severityReason        String?
  complianceStatus      ComplianceStatus  @default(PENDING)
  complianceCheckedAt   DateTime?
  location              String?           @db.Text
  aiMeta                Json?

  /// Extended fields: witness, description, injuries, staff actions, body map, notifications, follow-up, signatures, activity log, outcome summary, etc.
  payload Json

  staffId   String?
  staff     User?   @relation("IncidentReportStaff", fields: [staffId], references: [id], onDelete: SetNull)
  staffName String?

  createdBy  String
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  deletedAt  DateTime?
  activities IncidentActivity[]

  @@index([tenantId])
  @@index([residentId])
  @@index([occurredAt])
  @@index([incidentType])
  @@index([status])
  @@index([tenantId, occurredAt])
  @@index([deletedAt])
  @@map("incident_reports")
}

model IncidentActivity {
  id            String                 @id @default(uuid())
  incidentId    String
  incident      IncidentReport         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  tenantId      String
  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  action        IncidentActivityAction
  actorUserId   String?
  actorUser     User?                  @relation("IncidentActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorUserName String?
  note          String?                @db.Text
  metadata      Json?
  createdAt     DateTime               @default(now())

  @@index([incidentId])
  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
  @@index([incidentId, createdAt])
  @@map("incident_activities")
}

// BehavioralNote - AI-generated narrative notes for behavioral records
model BehavioralNote {
  id           String  @id @default(uuid())
  residentId   String // Resident.id (UUID)
  residentName String? // Cached resident name
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Date Range
  startDate DateTime // Start date of period covered
  endDate   DateTime // End date of period covered

  // Narrative Content
  narrative      String  @db.Text // AI-generated or manually edited narrative
  isAiGenerated  Boolean @default(true) // Flag to indicate if AI-generated
  currentVersion Int     @default(0) // Current version number

  // Metadata
  generatedBy String? // User ID who triggered generation
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // Soft delete

  // Version History
  versions BehavioralNoteVersion[]

  @@index([residentId])
  @@index([tenantId])
  @@index([startDate])
  @@index([endDate])
  @@index([tenantId, residentId])
  @@index([tenantId, residentId, startDate, endDate])
  @@index([deletedAt])
  @@map("behavioral_notes")
}

// BehavioralNoteVersion - Immutable version history for behavioral notes
model BehavioralNoteVersion {
  id      String         @id @default(uuid())
  noteId  String
  note    BehavioralNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  version Int // Version number (0 = creation, 1, 2, 3... = edits)

  // Full snapshot of note at this version
  residentId    String
  residentName  String?
  tenantId      String
  startDate     DateTime
  endDate       DateTime
  narrative     String   @db.Text
  isAiGenerated Boolean

  // Who created this version
  createdBy String? // User ID who created/edited this version (null if user deleted)
  creator   User?    @relation("BehavioralNoteVersionCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([noteId, version]) // Ensure one version per number per note
  @@index([noteId])
  @@index([noteId, version])
  @@index([createdBy])
  @@index([createdAt])
  @@map("behavioral_note_versions")
}

// ============================================
// Nursing Care Plan (NCP) Models
// ============================================

// Enum for care plan status
enum CarePlanStatus {
  Active
  Archived
  Draft
  PendingReview
}

// Enum for problem category
enum ProblemCategory {
  Medical
  Behavioral
  Functional
  Social
  Other
}

// Enum for goal status
enum GoalStatus {
  InProgress
  Achieved
  NotAchieved
  Discontinued
}

// Enum for intervention frequency
enum InterventionFrequency {
  Daily
  TwiceDaily
  Weekly
  PRN
  AsNeeded
  Custom
}

// Enum for alert type
enum AlertType {
  ReviewDue
  NewDiagnosis
  GoalNotMet
  InterventionOverdue
}

// CarePlan - Master care plan record per resident
model CarePlan {
  id           String  @id @default(uuid())
  residentId   String // Resident.id (UUID)
  residentName String? // Cached resident name for display
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Care Plan Details
  status      CarePlanStatus @default(Draft)
  title       String? // Optional title/name for the care plan
  description String?        @db.Text // Optional overall description

  // Review & Compliance
  lastReviewedAt     DateTime? // Last review date
  nextReviewDate     DateTime? // Next scheduled review date
  reviewIntervalDays Int?      @default(30) // Days between reviews (default 30)

  // Approval
  approvedBy     String? // User ID who approved
  approvedAt     DateTime? // Approval date
  approvedByName String? // Cached approver name

  // Metadata
  createdBy      String? // User ID who created the care plan (null if user deleted)
  creator        User?     @relation("CarePlanCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime? // Soft delete timestamp
  currentVersion Int       @default(0) // Current version number

  // Relations
  problems CarePlanProblem[]
  versions CarePlanVersion[]
  alerts   CarePlanAlert[]

  @@index([residentId])
  @@index([tenantId])
  @@index([status])
  @@index([createdBy])
  @@index([tenantId, residentId])
  @@index([tenantId, residentId, status])
  @@index([nextReviewDate])
  @@index([deletedAt])
  @@map("care_plans")
}

// CarePlanProblem - Medical/behavioral problems/diagnoses
model CarePlanProblem {
  id         String   @id @default(uuid())
  carePlanId String
  carePlan   CarePlan @relation(fields: [carePlanId], references: [id], onDelete: Cascade)

  // Problem Details
  title         String // Problem title (e.g., "Diabetes Mellitus Type II")
  category      ProblemCategory @default(Medical)
  description   String?         @db.Text // Detailed description
  diagnosisCode String? // ICD-10 or other diagnosis code
  onsetDate     DateTime? // When problem was identified

  // Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  // Relations
  goals CarePlanGoal[]

  @@index([carePlanId])
  @@index([category])
  @@index([deletedAt])
  @@map("care_plan_problems")
}

// CarePlanGoal - Goals for each problem
model CarePlanGoal {
  id        String          @id @default(uuid())
  problemId String
  problem   CarePlanProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  // Goal Details
  description  String     @db.Text // Goal description (e.g., "Maintain blood glucose < 150 mg/dL")
  status       GoalStatus @default(InProgress)
  targetDate   DateTime? // Target date for achieving goal
  achievedDate DateTime? // When goal was achieved

  // Evaluation
  evaluationNotes String?   @db.Text // Progress notes and evaluation
  lastEvaluatedAt DateTime? // Last evaluation date

  // Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  // Relations
  interventions CarePlanIntervention[]

  @@index([problemId])
  @@index([status])
  @@index([targetDate])
  @@index([deletedAt])
  @@map("care_plan_goals")
}

// CarePlanIntervention - Specific care actions/interventions
model CarePlanIntervention {
  id     String       @id @default(uuid())
  goalId String
  goal   CarePlanGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  // Intervention Details
  description     String                @db.Text // Intervention description (e.g., "Monitor blood glucose before meals")
  frequency       InterventionFrequency @default(Daily)
  customFrequency String? // Custom frequency description (if frequency is Custom)
  timesPerDay     Int? // Number of times per day (if applicable)
  timeSlots       Json? // Array of time slots ["08:00", "12:00", "16:00", "20:00"]

  // Responsible Staff
  responsibleRole    String? // Role responsible (e.g., "Caregiver", "Nurse")
  responsibleStaffId String? // Specific staff member ID (optional)

  // Links to other modules
  medicationId String? // Link to medication (if medication-related)
  noteId       String? // Link to progress note (if applicable)

  // Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  @@index([goalId])
  @@index([frequency])
  @@index([responsibleStaffId])
  @@index([medicationId])
  @@index([deletedAt])
  @@map("care_plan_interventions")
}

// CarePlanVersion - Immutable version history (full snapshots)
model CarePlanVersion {
  id         String   @id @default(uuid())
  carePlanId String
  carePlan   CarePlan @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
  version    Int // Version number (0 = creation, 1, 2, 3... = edits)

  // Full snapshot of care plan at this version
  residentId         String
  residentName       String?
  tenantId           String
  status             CarePlanStatus
  title              String?
  description        String?        @db.Text
  lastReviewedAt     DateTime?
  nextReviewDate     DateTime?
  reviewIntervalDays Int?
  approvedBy         String?
  approvedAt         DateTime?
  approvedByName     String?

  // Full snapshot of problems, goals, and interventions (stored as JSON)
  problemsSnapshot Json // Array of problems with goals and interventions

  // Change Summary
  changeSummary String? @db.Text // Summary of changes in this version

  // Who created this version
  createdBy String? // User ID who created/edited this version (null if user deleted)
  creator   User?    @relation("CarePlanVersionCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([carePlanId, version]) // Ensure one version per number per care plan
  @@index([carePlanId])
  @@index([carePlanId, version])
  @@index([createdBy])
  @@index([createdAt])
  @@map("care_plan_versions")
}

// CareLibrary - Reusable care instruction templates
model CareLibrary {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Library Item Details
  name        String // Template name (e.g., "Fall Risk Management")
  category    ProblemCategory @default(Medical)
  description String?         @db.Text // Description of when to use this template

  // Template Structure (stored as JSON)
  // Contains: problem, goals[], interventions[]
  templateData Json // { problem: {...}, goals: [...], interventions: [...] }

  // Metadata
  isActive  Boolean   @default(true)
  createdBy String? // User ID who created (null if user deleted)
  creator   User?     @relation("CareLibraryCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  @@index([tenantId])
  @@index([category])
  @@index([isActive])
  @@index([deletedAt])
  @@map("care_library")
}

// CarePlanAlert - Review reminders and alerts
model CarePlanAlert {
  id         String   @id @default(uuid())
  carePlanId String
  carePlan   CarePlan @relation(fields: [carePlanId], references: [id], onDelete: Cascade)

  // Alert Details
  alertType   AlertType
  title       String // Alert title
  message     String    @db.Text // Alert message
  isDismissed Boolean   @default(false)
  dismissedAt DateTime?
  dismissedBy String? // User ID who dismissed

  // Metadata
  createdAt  DateTime  @default(now())
  resolvedAt DateTime? // When alert was resolved (if applicable)

  @@index([carePlanId])
  @@index([alertType])
  @@index([isDismissed])
  @@index([createdAt])
  @@map("care_plan_alerts")
}

