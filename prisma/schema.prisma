// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Multi-tenancy: Tenant/Organization model
model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                    User[]
  userTenants              UserTenant[]
  refreshTokens            RefreshToken[]
  pdfEmbeddings            PdfEmbedding[]
  formSchemas              FormSchema[]
  formDrafts               FormDraft[]
  pdfTemplates             PdfTemplate[]
  notes                    Note[]
  residents                Resident[]
  billingTiers             BillingTier[]
  residentBillings         ResidentBilling[]
  invoices                 Invoice[]
  claimsBillingRecords     ClaimsBillingRecord[]
  claimsBillingTiers       ClaimsBillingTier[]
  claimsProviderSettings   ClaimsProviderSettings?
  medications              Medication[]
  medicationSchedules      MedicationSchedule[]
  marRecords               MarRecord[]
  prnRecords               PrnRecord[]
  vitalSigns               VitalSign[]
  medicationPrescriptions  MedicationPrescription[]
  behavioralLogs           BehavioralLog[]
  behavioralNotes          BehavioralNote[]
  incidentReports          IncidentReport[]
  incidentActivities       IncidentActivity[]
  carePlans                CarePlan[]
  careLibraries            CareLibrary[]
  ncpExtractions           NcpExtraction[]
  facilities               Facility[]
  staffMembers             StaffMember[]
  roles                    CustomRole[]
  appointments             Appointment[]
  appointmentReminders     AppointmentReminder[]
  appointmentNotifications AppointmentNotification[]
  birthdayNotifications           BirthdayNotification[]
  documentComplianceNotifications DocumentComplianceNotification[]
  documentComplianceCaches          DocumentComplianceCache[]
  documentComplianceSettings        TenantDocumentComplianceSettings?
  tasks                           Task[]
  outboundDeliveries              OutboundDelivery[]

  @@map("tenants")
}

// User model with multi-tenancy support
// Note: SUPER_ADMIN role users can access all tenants (tenantId can be NULL)
model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  name            String
  tenantId        String? // Optional for SUPER_ADMIN users
  role            Role      @default(STAFF)
  isEmailVerified Boolean   @default(false)
  isActive        Boolean   @default(true)
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  phone           String?   @db.VarChar(30)
  avatarUrl       String?   @map("avatar_url") @db.VarChar(2048)
  avatarS3Key     String?   @map("avatar_s3_key") @db.VarChar(1024)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant                   Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  refreshTokens            RefreshToken[]
  passwordResetTokens      PasswordResetToken[]
  formDrafts               FormDraft[]
  notes                    Note[]                    @relation("NoteStaff") // Notes created by this staff member
  noteVersions             NoteVersion[]             @relation("NoteVersionStaff") // Note versions created by this staff member
  noteVersionCreations     NoteVersion[]             @relation("NoteVersionCreator") // Note versions created/edited by this user
  marRecords               MarRecord[]               @relation("MarRecordCaregiver") // Records where user is caregiver
  prnRecords               PrnRecord[]               @relation("PrnRecordCaregiver") // PRN records where user is caregiver
  vitalSigns               VitalSign[]               @relation("VitalSignRecorder") // Vitals recorded by user
  behavioralLogs           BehavioralLog[]           @relation("BehavioralLogStaff") // Behavioral logs created by user
  behavioralNoteVersions   BehavioralNoteVersion[]   @relation("BehavioralNoteVersionCreator") // Behavioral note versions created/edited by user
  incidentReportsStaff     IncidentReport[]          @relation("IncidentReportStaff")
  incidentActivities       IncidentActivity[]        @relation("IncidentActivityActor")
  carePlans                CarePlan[]                @relation("CarePlanCreator") // Care plans created by user
  carePlanVersions         CarePlanVersion[]         @relation("CarePlanVersionCreator") // Care plan versions created/edited by user
  careLibraries            CareLibrary[]             @relation("CareLibraryCreator") // Care library items created by user
  ncpExtractions           NcpExtraction[]           @relation("NcpExtractionCreator") // NCP extractions created by user
  ncpApprovalsGiven        NcpExtraction[]           @relation("NcpExtractionApprover") // NCP extractions approved by user
  ncpArchivesGiven         NcpExtraction[]           @relation("NcpExtractionArchiver") // NCP extractions archived by user
  staffMember              StaffMember? // Staff document management - links to User (role STAFF) created by admin
  userRoleAssignments      UserRoleAssignment[]
  userTenants              UserTenant[]
  appointmentNotifications AppointmentNotification[]
  birthdayNotifications           BirthdayNotification[]
  documentComplianceNotifications DocumentComplianceNotification[]
  fcmTokens                       UserFcmToken[]
  tasksCreated                    Task[]                    @relation("TaskCreator")
  tasksAssigned            Task[]                    @relation("TaskAssignee")

  @@index([email])
  @@index([tenantId])
  @@map("users")
}

// User can belong to multiple tenants (e.g. one facility = one tenant; same login, switch between facilities)
model UserTenant {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  role      Role     @default(STAFF)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@map("user_tenants")
}

// Enum for user roles
enum Role {
  SUPER_ADMIN // Can access all tenants, manage system
  ADMIN // Can manage their tenant(s)
  STAFF // Regular staff member
  GUARDIAN // Guardian role
}

// Enum for note types
enum NoteType {
  Care // Care-related notes
  Behavior // Behavior observation notes
  Incident // Incident reports
  StatusUpdate // Status update notes
}

// Refresh tokens for JWT rotation
// Tokens are now user-specific, tenant context determined by UserTenant relationship
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  tenantId  String? // Optional: for tenant-specific sessions
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([token])
  @@map("refresh_tokens")
}

// Password reset tokens
model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

// PDF Embeddings stored per tenant using pgvector
model PdfEmbedding {
  id        String   @id
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileName  String?
  content   String
  embedding String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("pdf_embeddings")
}

// WAC/RCW Regulation Embeddings for compliance
model WacRcwRegulation {
  id            String   @id @default(uuid())
  type          String // 'wac' or 'rcw'
  citeCode      String // e.g., '388-76-10600'
  section       String // Same as citeCode
  title         String
  text          String   @db.Text // Regulation chunk text
  effectiveDate String? // ISO date string
  version       String? // Version number
  source        String? // 'api' or 'web'
  lastFetched   DateTime @default(now())
  chunkIndex    Int      @default(0)
  totalChunks   Int      @default(1)
  embedding     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type])
  @@index([citeCode])
  @@index([type, citeCode])
  @@map("wac_rcw_regulations")
}

// AI-Generated Form Schemas per tenant
model FormSchema {
  id                  String    @id @default(uuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  formName            String
  description         String?
  schemaJson          Json // Stores the AI-generated form schema (includes WAC/RCW citations)
  isActive            Boolean   @default(true)
  createdBy           String? // User ID who triggered generation
  isWacRcwCompliant   Boolean   @default(false) // Indicates if schema includes WAC/RCW citations
  complianceVersion   String? // Version of compliance rules used (e.g., "2025-01")
  lastComplianceCheck DateTime? // Last time compliance was validated
  adminApproved       Boolean   @default(false) // HITL approval flag
  adminApprovedBy     String? // User ID who approved
  adminApprovedAt     DateTime? // When approved
  complianceNotes     String? // Admin notes on compliance review
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  drafts FormDraft[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([isWacRcwCompliant])
  @@index([adminApproved])
  @@map("tenant_form_schemas")
}

// Form Drafts - Save partial form submissions
model FormDraft {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  formId    String
  draftData Json // Partial form data
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  form   FormSchema @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([formId])
  @@index([tenantId, userId])
  @@index([formId, userId])
  @@map("form_drafts")
}

// PDF Templates - Store PDF templates with field positions for form filling
model PdfTemplate {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileName     String // Original PDF file name
  fileHash     String? // SHA256 hash of PDF content for duplicate detection
  s3Key        String // S3 storage key for the template PDF
  s3Url        String // S3 URL for the template PDF
  displayName  String? // Human-readable display name
  description  String? // Optional description
  fieldMapping Json // Maps form schema fields to PDF positions
  isActive     Boolean  @default(true)
  createdBy    String? // User ID who uploaded
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, fileHash]) // Index for duplicate detection
  @@map("pdf_templates")
}

// Progress Notes - Daily notes for residents
// residentId references Resident.id (UUID)
model Note {
  id             String    @id @default(uuid())
  residentId     String // Reference to Resident.id (UUID)
  residentName   String? // Resident name (stored for display purposes)
  staffId        String? // User who created the note (null if user deleted)
  staff          User?     @relation("NoteStaff", fields: [staffId], references: [id], onDelete: SetNull)
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type           NoteType // Note type: Care, Behavior, Incident, Status Update
  description    String    @db.Text // Note description
  currentVersion Int       @default(0) // Current version number (tracks latest version)
  deletedAt      DateTime? // Soft delete timestamp (null = not deleted)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  versions NoteVersion[] // Edit history

  @@index([residentId])
  @@index([staffId])
  @@index([tenantId])
  @@index([type])
  @@index([createdAt])
  @@index([tenantId, residentId])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@index([deletedAt])
  @@map("notes")
}

enum ResidentStatus {
  ACTIVE
  INACTIVE
}

// Resident - Dedicated resident table with all fields from fields.json
model Resident {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String // User who created the resident
  deletedAt DateTime? // Legacy soft delete timestamp (prefer status for archive)
  status    ResidentStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Resident Information (from fields.json)
  residentFullLegalName   String?   @map("resident_full_legal_name")
  residentPreferredName   String?   @map("resident_preferred_name")
  residentDateOfBirth     DateTime? @map("resident_date_of_birth") @db.Date
  residentGenderSex       String?   @map("resident_gender_sex")
  residentSsn             String?   @map("resident_ssn")
  residentMedicareNumber  String?   @map("resident_medicare_number")
  residentMedicaidDshsId  String?   @map("resident_medicaid_dshs_id")
  residentVaNumber        String?   @map("resident_va_number")
  residentPrimaryLanguage String?   @map("resident_primary_language")
  residentNeedInterpreter Boolean?  @map("resident_need_interpreter")

  // Default claims billing tier (optional - used to pre-fill tier when creating billing records)
  claimsBillingTierId String?            @map("claims_billing_tier_id")
  claimsBillingTier   ClaimsBillingTier? @relation(fields: [claimsBillingTierId], references: [id], onDelete: SetNull)

  // Client Information (client may differ from resident - e.g. guardian who submitted resident)
  // Auto-populates when creating billing records
  clientId        String? @map("client_id")
  clientAddress   String? @map("client_address")
  clientCity      String? @map("client_city")
  clientState     String? @map("client_state")
  clientZip       String? @map("client_zip")
  placeOfService  String? @map("place_of_service") // e.g. "13", "14", "33"
  clientFirstName String? @map("client_first_name")
  clientLastName  String? @map("client_last_name")
  diagnosisCode   String? @map("diagnosis_code") // ICD/Diagnosis code for billing

  // Resident Picture (from resident_fields.json)
  residentPhoto          String?   @map("resident_photo")
  residentPhotoVerified  Boolean?  @map("resident_photo_verified")
  residentPhotoDateTaken DateTime? @map("resident_photo_date_taken") @db.Date
  residentPhotoNotes     String?   @map("resident_photo_notes")

  // Admission Information
  admissionDate                      DateTime? @map("admission_date") @db.Date
  admissionType                      String?   @map("admission_type")
  // Note: admissionReferralSource removed (replaced by externalFacilityReferringFacility)
  admissionPreviousLivingArrangement String?   @map("admission_previous_living_arrangement")
  admissionRoomNumber                String?   @map("admission_room_number")
  admissionCodeStatus                String?   @map("admission_code_status")
  admissionStatus                    String?   @map("admission_status") // Active | Discharged | Deceased
  admissionPoaOnFile                 Boolean?  @map("admission_poa_on_file")
  admissionPoaType                   String?   @map("admission_poa_type")
  admissionAgreementSigned           Boolean?  @map("admission_agreement_signed")

  // Emergency Contacts
  emergencyPrimaryContactName           String?  @map("emergency_primary_contact_name")
  emergencyPrimaryContactRelationship   String?  @map("emergency_primary_contact_relationship")
  emergencyPrimaryContactPhone          String?  @map("emergency_primary_contact_phone")
  emergencyPrimaryContactEmail          String?  @map("emergency_primary_contact_email")
  emergencySecondaryContactName         String?  @map("emergency_secondary_contact_name")
  emergencySecondaryContactRelationship String?  @map("emergency_secondary_contact_relationship")
  emergencySecondaryContactPhone        String?  @map("emergency_secondary_contact_phone")
  emergencySecondaryContactEmail        String?  @map("emergency_secondary_contact_email")
  emergencyLegalDecisionMakerName       String?  @map("emergency_legal_decision_maker_name")
  emergencyAdvancedDirectiveOnFile      Boolean? @map("emergency_advanced_directive_on_file")
  emergencyPolstOnFile                  Boolean? @map("emergency_polst_on_file")
  emergencyGuardianAppointed            Boolean? @map("emergency_guardian_appointed")
  emergencyCourtOrdersRestrictions      Boolean? @map("emergency_court_orders_restrictions")
  emergencyPoaOnFile                    Boolean? @map("emergency_poa_on_file")
  emergencyPoaType                      String?  @map("emergency_poa_type") // Medical | Financial | Both
  emergencyCodeStatus                   String?  @map("emergency_code_status") // Full Code | DNR | DNI

  // Medical Information
  medicalPrimaryDiagnosis   String? @map("medical_primary_diagnosis")
  medicalSecondaryDiagnoses Json?   @map("medical_secondary_diagnoses") // Array of strings
  medicalChronicConditions  String? @map("medical_chronic_conditions")

  // Diagnosis Information (from resident_fields.json)
  diagnosisPrimaryDiagnosis      String?   @map("diagnosis_primary_diagnosis")
  diagnosisSecondaryDiagnoses    Json?     @map("diagnosis_secondary_diagnoses") // Array of strings
  diagnosisChronicConditions     String?   @map("diagnosis_chronic_conditions")
  diagnosisCognitiveStatus       String?   @map("diagnosis_cognitive_status")
  diagnosisDementiaDiagnosis     Boolean?  @map("diagnosis_dementia_diagnosis")
  diagnosisMentalHealthDiagnoses String?   @map("diagnosis_mental_health_diagnoses")
  diagnosisBehavioralDiagnoses   String?   @map("diagnosis_behavioral_diagnoses")
  diagnosisLastReviewDate        DateTime? @map("diagnosis_last_review_date") @db.Date
  medicalAllergies               String?   @map("medical_allergies")
  medicalCurrentPharmacy         String?   @map("medical_current_pharmacy")

  // Allergies (from resident_fields.json)
  allergiesMedicationAllergies    String? @map("allergies_medication_allergies")
  allergiesFoodAllergies          String? @map("allergies_food_allergies")
  allergiesEnvironmentalAllergies String? @map("allergies_environmental_allergies")
  allergiesAllergySeverity        String? @map("allergies_allergy_severity")
  allergiesReactionNotes          String? @map("allergies_reaction_notes")

  // Care Needs (from resident_fields.json)
  careNeedsFallRisk               String? @map("care_needs_fall_risk") // Low | Medium | High
  careNeedsMobilityAidsUsed       String? @map("care_needs_mobility_aids_used")
  careNeedsSpecialPrecautions     String? @map("care_needs_special_precautions")
  careNeedsBehavioralTriggers     String? @map("care_needs_behavioral_triggers")
  medicalPrimaryCareProviderName  String? @map("medical_primary_care_provider_name")
  medicalPrimaryCareProviderPhone String? @map("medical_primary_care_provider_phone")
  medicalPrimaryCareClinic        String? @map("medical_primary_care_clinic")
  medicalSpecialistProviders      String? @map("medical_specialist_providers")

  // Care Providers (from resident_fields.json)
  careProviderPrimaryCareFax         String?  @map("care_provider_primary_care_fax")
  careProviderSpecialistCardiology   String?  @map("care_provider_specialist_cardiology")
  careProviderSpecialistNeurology    String?  @map("care_provider_specialist_neurology")
  careProviderSpecialistPsychiatry   String?  @map("care_provider_specialist_psychiatry")
  careProviderSpecialistOther        String?  @map("care_provider_specialist_other")
  careProviderCaseManagerName        String?  @map("care_provider_case_manager_name")
  careProviderCaseManagerAgency      String?  @map("care_provider_case_manager_agency")
  careProviderCaseManagerPhone       String?  @map("care_provider_case_manager_phone")
  careProviderBehavioralHealthName   String?  @map("care_provider_behavioral_health_name")
  careProviderBehavioralHealthPhone  String?  @map("care_provider_behavioral_health_phone")
  medicalRecentHospitalization90Days Boolean? @map("medical_recent_hospitalization_90_days")

  // Pharmacy (from resident_fields.json)
  pharmacyName             String? @map("pharmacy_name")
  pharmacyAddress          String? @map("pharmacy_address")
  pharmacyPhone            String? @map("pharmacy_phone")
  pharmacyFax              String? @map("pharmacy_fax")
  pharmacyAccountNumber    String? @map("pharmacy_account_number")
  pharmacyDeliverySchedule String? @map("pharmacy_delivery_schedule")
  pharmacyNotes            String? @map("pharmacy_notes")

  // External Facilities (from resident_fields.json)
  externalFacilityPreviousLiving     String? @map("external_facility_previous_living")
  externalFacilityReferringFacility  String? @map("external_facility_referring_facility")
  externalFacilityHospitalErMostUsed String? @map("external_facility_hospital_er_most_used")
  externalFacilitySkilledNursing     String? @map("external_facility_skilled_nursing")
  externalFacilityDialysisCenter     String? @map("external_facility_dialysis_center")
  externalFacilityOther              String? @map("external_facility_other")

  // Insurance Information
  insurancePrimaryPayer             String?   @map("insurance_primary_payer")
  insuranceCarrier                  String?   @map("insurance_carrier")
  insurancePolicyMemberNumber       String?   @map("insurance_policy_member_number")
  insuranceAuthorizationClaimNumber String?   @map("insurance_authorization_claim_number")
  insuranceAuthorizationStartDate   DateTime? @map("insurance_authorization_start_date") @db.Date
  insuranceAuthorizationEndDate     DateTime? @map("insurance_authorization_end_date") @db.Date
  insuranceDailyRateOrHours         Decimal?  @map("insurance_daily_rate_or_hours") @db.Decimal(10, 2)
  insuranceResponsiblePartyPayment  String?   @map("insurance_responsible_party_payment")

  // Payer Information (from resident_fields.json)
  payerSecondaryPayer        String?  @map("payer_secondary_payer")
  payerApprovedTierDailyRate String?  @map("payer_approved_tier_daily_rate")
  payerApprovedHours         Decimal? @map("payer_approved_hours") @db.Decimal(10, 2)
  payerBillingNotes          String?  @map("payer_billing_notes")

  // Note: Preventive Care section removed (10 fields) - not in new requirements
  // Note: Functional Information section removed (3 fields) - replaced by care_needs_* fields
  // Note: Medication Information section removed (6 fields) - not in new requirements
  // Note: Diet Information section removed (5 fields) - diet_food_allergies migrated to allergies_food_allergies
  // Note: Skin Information section removed (5 fields) - not in new requirements
  // Note: Mental Health Information section removed (4 fields) - mental_health_diagnoses replaced by diagnosis_mental_health_diagnoses
  // Note: End of Life Information section removed (4 fields) - not in new requirements
  // Note: Compliance Information section removed (5 fields) - not in new requirements

  // New schema fields (from updated_resident_fields.json)
  residentIdentificationFullLegalName               String?   @map("resident_identification_full_legal_name")
  residentIdentificationProfilePicture              String?   @map("resident_identification_profile_picture")
  residentIdentificationPreferredName               String?   @map("resident_identification_preferred_name")
  residentIdentificationDateOfBirth                 DateTime? @map("resident_identification_date_of_birth") @db.Date
  residentIdentificationGender                      String?   @map("resident_identification_gender")
  residentIdentificationSsn                         String?   @map("resident_identification_ssn")
  residentIdentificationAdmissionDate               DateTime? @map("resident_identification_admission_date") @db.Date
  residentIdentificationRoomNumber                  String?   @map("resident_identification_room_number")
  residentIdentificationResidentStatus              String?   @map("resident_identification_resident_status")
  emergencyLegalContactsPrimaryContactName          String?   @map("emergency_legal_contacts_primary_contact_name")
  emergencyLegalContactsPrimaryContactRelationship  String?   @map("emergency_legal_contacts_primary_contact_relationship")
  emergencyLegalContactsPrimaryContactPhone         String?   @map("emergency_legal_contacts_primary_contact_phone")
  emergencyLegalContactsSecondaryContactName        String?   @map("emergency_legal_contacts_secondary_contact_name")
  emergencyLegalContactsSecondaryContactPhone       String?   @map("emergency_legal_contacts_secondary_contact_phone")
  emergencyLegalContactsGuardianPoaExists           Boolean?  @map("emergency_legal_contacts_legal_guardian_poa_exists")
  emergencyLegalContactsGuardianPoaName             String?   @map("emergency_legal_contacts_legal_guardian_poa_name")
  emergencyLegalContactsGuardianPoaContactInfo      String?   @map("emergency_legal_contacts_legal_guardian_poa_contact_info") @db.Text
  emergencyLegalContactsGuardianPoaCopyOnFile       Boolean?  @map("emergency_legal_contacts_legal_guardian_poa_copy_on_file")
  medicalProvidersPrimaryCareProviderName           String?   @map("medical_providers_health_coverage_primary_care_provider_name")
  medicalProvidersPrimaryCareProviderPhone          String?   @map("medical_providers_health_coverage_primary_care_provider_phone")
  medicalProvidersMentalHealthProvider              String?   @map("medical_providers_health_coverage_mental_health_provider")
  medicalProvidersPreferredHospitalEr               String?   @map("medical_providers_health_coverage_preferred_hospital_er")
  medicalProvidersPharmacyName                      String?   @map("medical_providers_health_coverage_pharmacy_name")
  medicalProvidersPharmacyPhone                     String?   @map("medical_providers_health_coverage_pharmacy_phone")
  medicalProvidersHealthInsurancePayorType          String?   @map("medical_providers_health_coverage_health_insurance_payor_type")
  medicalProvidersHealthInsuranceMedicaidClientId   String?   @map("medical_providers_health_coverage_health_insurance_medicaid_client_id")
  medicalProvidersHealthInsuranceAuthorizedTier     Boolean?  @map("medical_providers_health_coverage_health_insurance_authorized_tier")
  diagnosesHealthConditionsDiagnoses                String?   @map("diagnoses_health_conditions_diagnoses")
  diagnosesHealthConditionsCommunicableDiseases     String?   @map("diagnoses_health_conditions_communicable_diseases")
  diagnosesHealthConditionsAllergies                String?   @map("diagnoses_health_conditions_allergies") @db.Text
  functionalStatusAdlsMobilityStatus                String?   @map("functional_status_adls_mobility_status")
  functionalStatusAdlsBathingAssistance             String?   @map("functional_status_adls_bathing_assistance")
  functionalStatusAdlsDressingAssistance            String?   @map("functional_status_adls_dressing_assistance")
  functionalStatusAdlsToiletingStatus               Json?     @map("functional_status_adls_toileting_status")
  functionalStatusAdlsEatingFeedingAssistance       String?   @map("functional_status_adls_eating_feeding_assistance")
  functionalStatusAdlsCommunicationAbility          String?   @map("functional_status_adls_communication_ability")
  functionalStatusAdlsCognitiveStatus               String?   @map("functional_status_adls_cognitive_status")
  functionalStatusAdlsRequiresCueingForAdls         Boolean?  @map("functional_status_adls_requires_cueing_for_adls")
  servicePlanNcpOnFile                              Boolean?  @map("service_plan_ncp_on_file")
  servicePlanNcpMostRecentDate                      DateTime? @map("service_plan_ncp_most_recent_date") @db.Date
  servicePlanNcpServicesAuthorized                  String?   @map("service_plan_ncp_services_authorized")
  medicationsTreatmentsTreatmentOrders              Json?     @map("medications_treatments_treatment_orders")
  medicationsTreatmentsTreatmentOrdersOtherNotes    String?   @map("medications_treatments_treatment_orders_other_notes") @db.Text
  behavioralSafetyRisksBehavioralConcerns           Json?     @map("behavioral_safety_risks_behavioral_concerns")
  behavioralSafetyRisksBehavioralConcernsOtherNotes String?   @map("behavioral_safety_risks_behavioral_concerns_other_notes") @db.Text
  behavioralSafetyRisksKnownTriggers                Json?     @map("behavioral_safety_risks_known_triggers")
  behavioralSafetyRisksKnownTriggersOtherNotes      String?   @map("behavioral_safety_risks_known_triggers_other_notes") @db.Text
  behavioralSafetyRisksDeEscalationTechniques       Json?     @map("behavioral_safety_risks_de_escalation_techniques")
  behavioralSafetyRisksDeEscalationOtherNotes       String?   @map("behavioral_safety_risks_de_escalation_other_notes") @db.Text
  behavioralSafetyRisksFallRisk                     String?   @map("behavioral_safety_risks_fall_risk")
  behavioralSafetyRisksElopementRisk                String?   @map("behavioral_safety_risks_elopement_risk")
  dietNutritionPrescribedDietType                   Json?     @map("diet_nutrition_prescribed_diet_type")
  dietNutritionPrescribedDietOtherNotes             String?   @map("diet_nutrition_prescribed_diet_other_notes") @db.Text
  dietNutritionFluidRestrictions                    String?   @map("diet_nutrition_fluid_restrictions")
  dietNutritionFluidRestrictionsOtherNotes          String?   @map("diet_nutrition_fluid_restrictions_other_notes") @db.Text
  dietNutritionFoodAllergies                        Json?     @map("diet_nutrition_food_allergies")
  dietNutritionFoodAllergiesOtherNotes              String?   @map("diet_nutrition_food_allergies_other_notes") @db.Text
  dietNutritionWeightMonitoringRequired             String?   @map("diet_nutrition_weight_monitoring_required")
  codeStatusAdvanceDirectivesCodeStatus             String?   @map("code_status_advance_directives_code_status")
  codeStatusAdvanceDirectivesPolstOnFile            String?   @map("code_status_advance_directives_polst_on_file")
  codeStatusAdvanceDirectivesAdvanceDirectiveOnFile String?   @map("code_status_advance_directives_advance_directive_on_file")
  financialCaseManagementCaseManagerName            String?   @map("financial_case_management_case_manager_name")
