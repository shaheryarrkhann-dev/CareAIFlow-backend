// ============================================
// AFH Negotiated Care Plan (NCP) Extraction Models
// ============================================

// Enum for NCP extraction status
enum NcpStatus {
  PENDING // Uploaded, waiting for extraction
  EXTRACTING // Currently being processed
  EXTRACTED // Data extracted, ready for review
  REVIEWED // User reviewed/approved
  POPULATED // DOCX generated
  FAILED // Extraction or population failed
}

// NCP Extraction - Stores extracted data from assessment PDFs
model NcpExtraction {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String? // User who uploaded/initiated extraction (optional for audit trail)
  user       User?     @relation("NcpExtractionCreator", fields: [userId], references: [id], onDelete: SetNull)
  residentId String? // Resident this NCP extraction belongs to
  resident   Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)

  // Source PDF info
  sourcePdfS3Key    String // S3 key of uploaded PDF
  sourcePdfFileName String
  sourcePdfSize     Int? // File size in bytes

  // Extracted data (JSON matching afh_ncp_schema_flat.json structure)
  extractedData Json // Stores all ~500+ fields from schema

  // DSHS/CBHS draft generation (Layer 1 + Layer 2)
  requiresCbhs Boolean @default(false) // If true, Layer 2 applies CBHS language standards
  cbhsNotes    String? @db.Text // Notes explaining why CBHS applies
  layer1Draft  Json? // Layer 1 output: extractedData rewritten in DSHS clinical language
  layer2Final  Json? // Layer 2 output: refined DSHS draft (+ CBHS if requiresCbhs = true)

  // Processing status
  status           NcpStatus @default(PENDING)
  extractionMethod String? // "openai", "hybrid", etc.
  extractionModel  String? // "gpt-4o", "gpt-4o-mini", etc.

  // Error handling
  errorMessage String? @db.Text
  retryCount   Int     @default(0)

  // Live progress for UI (0-100, set during EXTRACTING)
  progressPercent Int?
  bullJobId       String? // BullMQ job id when Redis queue is used

  // Generated DOCX
  populatedDocxS3Key String? // S3 key of populated DOCX
  populatedDocxUrl   String? // Public URL for download

  // Version tracking (increments each time DOCX is regenerated)
  ncpVersion Int @default(1)

  // Approval (user must approve before final download/print)
  approvedAt     DateTime?
  approvedBy     String? // User ID who approved
  approvedByName String? // Cached approver display name
  approvedByUser User?     @relation("NcpExtractionApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  // Metadata
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  extractedAt DateTime? // When extraction completed
  populatedAt DateTime? // When DOCX was generated

  // Archive (soft delete — record and files preserved)
  deletedAt  DateTime?
  archivedBy String?
  archiver   User?     @relation("NcpExtractionArchiver", fields: [archivedBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([residentId])
  @@index([status])
  @@index([tenantId, status])
  @@index([tenantId, residentId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("ncp_extractions")
}

// ============================================
// Facility Management Module
// ============================================

// Facility Profile (many per Tenant - multi-AFH operators)
model Facility {
  id                    String    @id @default(uuid())
  tenantId              String
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                  String
  licenseNumber         String?
  address               String?
  capacity              Int? // Beds
  licenseExpirationDate DateTime? @db.Date
  /// External image URL when not using uploaded photo (upload clears this)
  profilePhotoUrl       String?   @map("profile_photo_url") @db.VarChar(2048)
  profilePhotoS3Key     String?   @map("profile_photo_s3_key") @db.VarChar(1024)
  /// Main contact phone (UI/API validate; column name kept for compatibility)
  contactInformation    String?   @map("contact_information") @db.Text
  /// Facility email for letterhead / correspondence (optional)
  contactEmail          String?   @map("contact_email") @db.VarChar(255)
  /// Public website URL for letterhead (optional)
  website               String?   @db.VarChar(2048)
  /// JSON config controlling which fields appear in the letterhead (showLogo, showAddress, etc.)
  letterheadConfig      Json?     @map("letterhead_config")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  folders          FacilityFolder[]
  documents        FacilityDocument[]
  evacuationDrills EvacuationDrill[]
  visitorLogs      VisitorLog[]
  staffAssignments StaffFacilityAssignment[]
  qrConfig         FacilityQRConfig?
  appointments     Appointment[]

  @@index([tenantId])
  @@map("facilities")
}

// Folder display size (per-folder setting)
enum FolderSize {
  SMALL
  MEDIUM
  LARGE
}

// Nested folder structure for facility documents
model FacilityFolder {
  id              String           @id @default(uuid())
  facilityId      String
  facility        Facility         @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  parentId        String?
  parent          FacilityFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children        FacilityFolder[] @relation("FolderHierarchy")
  name            String
  size            FolderSize       @default(MEDIUM)
  color           String? // e.g. hex #rrggbb or preset name for easier identification
  passwordHash    String? // bcrypt hash; never returned in API
  isSystemDefault Boolean          @default(false) @map("is_system_default") // auto-created roots; non-deletable
  sortOrder       Int              @default(10000) @map("sort_order")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  documents FacilityDocument[]

  @@index([facilityId])
  @@index([parentId])
  @@index([facilityId, parentId, sortOrder])
  @@map("facility_folders")
}

// Facility documents (stored in S3)
model FacilityDocument {
  id         String          @id @default(uuid())
  facilityId String
  facility   Facility        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  folderId   String?
  folder     FacilityFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  fileName   String
  s3Key      String
  s3Url      String
  fileSize   Int?
  mimeType       String?
  expirationDate DateTime? @map("expiration_date") @db.Date
  uploadedBy     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([facilityId])
  @@index([folderId])
  @@index([expirationDate])
  @@map("facility_documents")
}

// Evacuation drill type
enum EvacuationDrillType {
  REGULAR // Every 60 days
  ANNUAL_FULL // Once per year
}

// Evacuation drills
model EvacuationDrill {
  id            String              @id @default(uuid())
  facilityId    String
  facility      Facility            @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  drillType     EvacuationDrillType
  scheduledDate DateTime            @db.Date
  completedDate DateTime?           @db.Date
  completedBy   String?
  notes         String?             @db.Text
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([facilityId])
  @@index([scheduledDate])
  @@index([completedDate])
  @@map("evacuation_drills")
}

// Visitor log
model VisitorLog {
  id                      String    @id @default(uuid())
  facilityId              String
  facility                Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  residentId              String?
  resident                Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)
  personVisitedName       String?   @map("person_visited_name") @db.VarChar(255) // Free-text from visitor (no directory exposed)
  visitorName             String
  visitorEmail            String?   @map("visitor_email") @db.VarChar(255)
  visitorPhone            String?   @map("visitor_phone") @db.VarChar(50)
  expectedDurationMinutes Int?      @map("expected_duration_minutes") // 15, 30, 60
  reminderSentAt          DateTime? @map("reminder_sent_at") // When 5-min reminder was emailed
  checkInAt               DateTime
  checkOutAt              DateTime?
  notes                   String?   @db.Text
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([facilityId])
  @@index([residentId])
  @@index([checkInAt])
  @@index([checkOutAt])
  @@map("visitor_logs")
}

// Visitor QR sign-in: per-facility token and printable template customization
model FacilityQRConfig {
  id                  String   @id @default(uuid())
  facilityId          String   @unique
  facility            Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  token               String   @unique // Secure token for QR link; regenerable
  instructionText     String?  @map("instruction_text") @db.VarChar(500) // e.g. "Scan to Sign In"
  disclaimerText      String?  @map("disclaimer_text") @db.VarChar(1000)
  layoutOption        String?  @map("layout_option") @db.VarChar(50) // e.g. "default", "compact"
  facilityDisplayName String?  @map("facility_display_name") @db.VarChar(255)
  logoUrl             String?  @map("logo_url") @db.VarChar(2048) // External URL; used when logoS3Key is null
  logoS3Key           String?  @map("logo_s3_key") @db.VarChar(1024) // S3 key when logo is uploaded (takes precedence)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([token])
  @@map("facility_qr_configs")
}

// ============================================
// Staff Document Management Module
// ============================================
// StaffMember links to User (role STAFF) - admin creates Users with role STAFF, StaffMember extends for document management

enum StaffEmploymentStatus {
  ACTIVE
  INACTIVE
}

// Staff Member - Links to User (role STAFF) for document management
model StaffMember {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String @unique // Links to User (role STAFF) - admin creates staff via User invite
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Employee profile (admin-maintained; separate from login User name/email when needed)
  profilePhotoUrl   String?
  profilePhotoS3Key String?
  fullLegalName     String?
  profilePhone      String?               @map("profile_phone")
  profileEmail      String?               @map("profile_email")
  address           String?               @db.Text
  jobTitle          String?               @map("job_title")
  hireDate          DateTime?             @map("hire_date") @db.Date
  emergencyContact  String?               @map("emergency_contact") @db.Text
  employmentStatus  StaffEmploymentStatus @default(ACTIVE) @map("employment_status")

  // Shown when employmentStatus is INACTIVE (separation / archive)
  separationTerminationRecord     String?   @map("separation_termination_record") @db.Text
  separationTerminationDate       DateTime? @map("separation_termination_date") @db.Date
  separationExitNotes             String?   @map("separation_exit_notes") @db.Text
  separationArchivedPersonnelNote String?   @map("separation_archived_personnel_note") @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  folders             StaffFolder[]
  documents           StaffDocument[]
  facilityAssignments StaffFacilityAssignment[]
  appointments        Appointment[]

  @@index([tenantId])
  @@index([userId])
  @@index([employmentStatus])
  @@map("staff_members")
}

// Staff-to-Facility assignment (many-to-many for multi-AFH operators)
model StaffFacilityAssignment {
  id         String      @id @default(uuid())
  staffId    String
  staff      StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  facilityId String
  facility   Facility    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  assignedAt DateTime    @default(now())

  @@unique([staffId, facilityId])
  @@index([staffId])
  @@index([facilityId])
  @@map("staff_facility_assignments")
}

// Nested folder structure for staff documents
model StaffFolder {
  id              String        @id @default(uuid())
  staffId         String
  staff           StaffMember   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  parentId        String?
  parent          StaffFolder?  @relation("StaffFolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children        StaffFolder[] @relation("StaffFolderHierarchy")
  name            String
  size            FolderSize    @default(MEDIUM)
  color           String? // e.g. hex #rrggbb or preset name for easier identification
  passwordHash    String? // bcrypt hash; never returned in API
  isSystemDefault Boolean       @default(false) @map("is_system_default") // auto-created roots; non-deletable
  sortOrder       Int           @default(10000) @map("sort_order") // roots 1–8; ad-hoc 10000
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  documents StaffDocument[]

  @@index([staffId])
  @@index([parentId])
  @@index([staffId, parentId, sortOrder])
  @@map("staff_folders")
}

// Document type enum
enum StaffDocumentType {
  LICENSE
  CERTIFICATION
  TRAINING
}

// Staff documents (stored in S3)
model StaffDocument {
  id             String            @id @default(uuid())
  staffId        String
  staff          StaffMember       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  documentType   StaffDocumentType // LICENSE | CERTIFICATION | TRAINING
  folderId       String?
  folder         StaffFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  fileName       String
  s3Key          String
  s3Url          String
  fileSize       Int?
  mimeType       String?
  expirationDate DateTime?         @db.Date
  uploadedBy     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([staffId])
  @@index([folderId])
  @@index([documentType])
  @@index([expirationDate])
  @@index([staffId, documentType])
  @@map("staff_documents")
}

// ============================================
// Appointment Tracking Module
// ============================================

enum AppointmentType {
  MEDICAL
  THERAPY
  INSPECTION
  INTERNAL_OTHER
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id              String            @id @default(uuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title           String
  scheduledAt     DateTime
  durationMinutes Int? // 15, 30, 45, or 60; null = 60 for backward compatibility
  location        String?
  notes           String?           @db.Text
  appointmentType AppointmentType
  status          AppointmentStatus @default(SCHEDULED)
  residentId      String?
  resident        Resident?         @relation(fields: [residentId], references: [id], onDelete: SetNull)
  staffId         String?
  staff           StaffMember?      @relation(fields: [staffId], references: [id], onDelete: SetNull)
  facilityId      String?
  facility        Facility?         @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  reminders AppointmentReminder[]

  @@index([tenantId])
  @@index([tenantId, scheduledAt])
  @@index([residentId])
  @@index([staffId])
  @@index([facilityId])
  @@index([scheduledAt])
  @@index([deletedAt])
  @@index([status])
  @@map("appointments")
}

model AppointmentReminder {
  id                    String      @id @default(uuid())
  appointmentId         String
  appointment           Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  tenantId              String
  tenant                Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reminderMinutesBefore Int // e.g. 60 (1h), 1440 (24h)
  sentAt                DateTime?
  createdAt             DateTime    @default(now())

  @@index([appointmentId])
  @@index([tenantId])
  @@index([sentAt])
  @@map("appointment_reminders")
}

model AppointmentNotification {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String // Recipient (User who sees the notification)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointmentId String
  reminderId    String? // Which AppointmentReminder triggered this
  title         String
  message       String    @db.Text
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
  @@index([userId, readAt])
  @@map("appointment_notifications")
}

// Birthday Tracking Notifications
model BirthdayNotification {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String // Recipient (staff who sees the notification)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  personType   String // "resident" or "staff"
  personId     String // Resident.id or User.id of the birthday person
  personName   String // Cached name for display
  birthdayDate DateTime  @db.Date // The actual birthday date this year
  title        String
  message      String    @db.Text
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
  @@index([userId, readAt])
  @@index([tenantId, birthdayDate])
  @@map("birthday_notifications")
}

model DocumentComplianceNotification {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType    String
  entityId      String
  entityName    String
  overallStatus String
  readiness     String
  title         String
  message       String    @db.Text
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
  @@index([userId, readAt])
  @@index([tenantId, entityType, entityId])
  @@map("document_compliance_notifications")
}

/// Cached per-profile evaluation (Phase 5 — fast dashboard).
model DocumentComplianceCache {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType  String
  entityId    String
  evaluation  Json
  evaluatedAt DateTime
