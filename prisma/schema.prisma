/// Tenant overrides for compliance rules and digest email (Phase 5).
model TenantDocumentComplianceSettings {
  id                 String    @id @default(uuid())
  tenantId           String    @unique
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  catalogOverrides   Json?
  emailDigestEnabled Boolean   @default(false)
  lastEmailDigestAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("tenant_document_compliance_settings")
}

model UserFcmToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
  @@index([userId])
  @@map("user_fcm_tokens")
}

// Task Manager - Daily Operations
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model Task {
  id           String       @id @default(uuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title        String
  description  String?      @db.Text
  dueDate      DateTime     @db.Date
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(PENDING)
  assigneeId   String?
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeRole String?
  createdById  String
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  completedAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([assigneeId])
  @@index([createdById])
  @@index([deletedAt])
  @@map("tasks")
}

// DocuSign Envelope Tracking
model DocuSignEnvelope {
  id                  String    @id @default(uuid())
  envelopeId          String    @unique @map("envelope_id")
  residentId          String    @map("resident_id")
  tenantId            String    @map("tenant_id")
  status              String    @default("sent")
  signerName          String    @map("signer_name")
  signerEmail         String    @map("signer_email")
  documentName        String    @map("document_name")
  signedAt            DateTime? @map("signed_at")
  completedAt         DateTime? @map("completed_at")
  signedDocumentUrl   String?   @map("signed_document_url") @db.Text
  signedDocumentS3Key String?   @map("signed_document_s3_key")
  createdBy           String    @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([residentId])
  @@index([envelopeId])
  @@index([status])
  @@index([deletedAt])
  @@map("docusign_envelopes")
}

// Outbound email/fax delivery log (PDF reports sent via SendGrid/SMTP or iFax)
model OutboundDelivery {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  type          String // "email" | "fax"
  status        String   @default("sent") // "sent" | "failed" | "queued"
  recipient     String
  subject       String?
  message       String?  @db.Text
  filename      String?
  recipientName String?  @map("recipient_name")
  senderName    String?  @map("sender_name")
  sourceModule  String?  @map("source_module")
  jobId         String?  @map("job_id")
  errorMessage  String?  @map("error_message") @db.Text
  attachmentS3Key String? @map("attachment_s3_key")
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@index([createdBy])
  @@map("outbound_deliveries")
}
